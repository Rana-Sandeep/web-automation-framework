<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- data-provider-thread-count = number of Cucumber scenarios running in parallel -->
<suite name="Web Automation Suite" data-provider-thread-count="3">
    <test name="Cucumber Scenarios">
        <classes>
            <class name="com.framework.runners.TestRunner"/>
        </classes>
    </test>
</suite>
